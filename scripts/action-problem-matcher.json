{
  "problemMatcher": [
    {
      "owner": "rosetta",
      "pattern": [
        {
          "regexp": "^(.+?):([0-9]+):([0-9]+): (warning|error): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
