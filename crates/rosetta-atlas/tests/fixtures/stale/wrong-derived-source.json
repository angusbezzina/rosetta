  "edges": [
    {
      "from": "web",
      "to": "door",
      "kind": "calls",
      "label": "request/answer"
    },
    {
      "from": "door",
      "to": "store",
      "kind": "writes"
    },
    {
      "from": "store",
      "to": "cells",
      "kind": "writes"
    },
    {
      "from": "store",
      "to": "edge",
      "kind": "publishes",
      "label": "outbox"
    },
    {
      "from": "edge",
      "to": "web",
      "kind": "delivers",
      "label": "live"
    },
    {
      "from": "apps-web",
      "to": "packages-ui",
      "kind": "depends",
      "derived": {
        "source": "package.json"
      }
    },
    {
      "from": "crates-door",
      "to": "crates-core",
      "kind": "depends",
      "derived": {
        "source": "Cargo.toml"
      }
    }
  ],
  "views": [
    {
      "id": "send",
      "kind": "flow",
      "title": "A message from send to screen",
      "description": "One message, typed to seen.",
      "steps": [
        {
          "node": "web",
          "label": "the person sends"
        },
        {
          "node": "door",
          "label": "answers \"accepted\""
        },
        {
          "node": "store",
          "label": "commits the row"
        },
        {
          "node": "edge",
          "label": "carries it live"
        },
        {
          "node": "web",
          "label": "the other screen shows it"
        }
      ]
    }
  ]
