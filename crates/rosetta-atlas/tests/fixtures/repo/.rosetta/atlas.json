  "edges": [
    { "from": "web", "to": "door", "kind": "calls", "label": "request/answer" },
    { "from": "door", "to": "store", "kind": "writes" },
    { "from": "store", "to": "cells", "kind": "writes" },
    { "from": "store", "to": "edge", "kind": "publishes", "label": "outbox" },
    { "from": "edge", "to": "web", "kind": "delivers", "label": "live" },
    {
      "from": "infra-src-compute-door-cloudrunv2-service",
      "to": "door",
      "kind": "deploys",
      "label": "runs"
    },
    {
      "from": "apps-web",
      "to": "packages-ui",
      "kind": "depends",
      "derived": { "source": "package.json" }
    },
    {
      "from": "crates-door",
      "to": "crates-core",
      "kind": "depends",
      "derived": { "source": "Cargo.toml" }
    }
  ],
  "views": [
    {
      "id": "send",
      "kind": "flow",
      "title": "A message from send to screen",
      "description": "One message, typed to seen.",
      "steps": [
        { "node": "web", "label": "the person sends" },
        { "node": "door", "label": "answers \"accepted\"" },
        { "node": "door", "label": "checks the policy" },
        { "node": "store", "label": "commits the row" },
        { "node": "cells", "label": "keeps it" },
        { "node": "edge", "label": "carries it live" },
        { "node": "packages-ui", "label": "draws it" },
        { "node": "web", "label": "the other screen shows it" }
      ]
    },
    {
      "id": "write-path",
      "kind": "custom",
      "title": "The write path",
      "description": "What a write passes through.",
      "include": ["web", "door", "store", "cells", "packages-ui"]
    }
  ],
  "records": {
    "file": "packages/virgil-schema/src/generated/schemas.json",
    "areas": [
      {
        "id": "conversation",
        "title": "Messages and channels",
        "collections": ["message", "chan*"]
      },
      { "id": "people", "title": "People", "collections": ["principal"] }
    ]
  }
